{
	"name": "ugolok",
	"version": "1.0.0",
	"description": "Замкнутый мессенджер на Nostr для локальной сети",
	"homepage": "https://github.com/naysy-sx/ugolok-03#readme",
	"bugs": {
		"url": "https://github.com/naysy-sx/ugolok-03/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/naysy-sx/ugolok-03.git"
	},
	"license": "ISC",
	"author": "",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"allowScripts": {
		"fsevents": false
	},
	"main": "index.html",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"test": "node --test tests/*.test.js tests/harness/*.test.js",
		"gen:icons": "node scripts/gen-icons.mjs",
		"build:capacitor": "vite build --mode capacitor",
		"build:tauri": "vite build --mode tauri",
		"native:android": "node -e \"console.error('native/mobile (Capacitor Android) ещё не создан — Э3 ТЗ-NATIVE-APPS'); process.exit(1)\"",
		"native:ios": "node -e \"console.error('native/mobile (Capacitor iOS) ещё не создан — Э3 ТЗ-NATIVE-APPS, отложено владельцем (недостаточно диска для Xcode)'); process.exit(1)\"",
		"native:desktop:dev": "cd native/desktop/src-tauri && tauri dev",
		"native:desktop:build": "cd native/desktop/src-tauri && tauri build",
		"native:sync": "node -e \"console.error('native/mobile ещё не создан — нечего синхронизировать (Capacitor sync — Э3 ТЗ-NATIVE-APPS)'); process.exit(1)\""
	},
	"dependencies": {
		"@capacitor/browser": "^8.0.4",
		"@fontsource/golos-text": "^5.3.0",
		"@fontsource/unbounded": "^5.3.0",
