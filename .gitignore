# Служебные заметки разработки живут в ветке process.
# .gitignore не защищает от merge process → main: при слиянии файлы вернутся.
CLAUDE.md
worker.sh
.claude/
PROCESS-DOCS/

node_modules/
dist/
.DS_Store
*.log
.env
.env.*
dist-updates/
deploy/.env

# server/strfry — тестовый relay, поднимается локально по docs в server/README.md.
# Исходники/сборка/БД не версионируются (бинарь платформозависим, БД — локальные
# тестовые данные, может расти неограниченно). strfry.conf и наши скрипты — версионируются.
server/strfry/strfry-src/
server/strfry/strfry-db/
server/strfry/strfry.log

# server/blossom — тестовый Blossom-сервер (sebdeveloper6952/blossom-server, Go),
# тот же принцип, что server/strfry выше: исходники/сборка/БД не версионируются,
# config.yml/setup.sh/run.sh — версионируются.
server/blossom/blossom-src/
server/blossom/blossom-db/
server/blossom/blossom.log

# server/coturn — локальный TURN/STUN (Homebrew coturn). Конфиг и скрипты
# версионируются, pid/лог — нет.
server/coturn/turnserver.pid
server/coturn/coturn.log