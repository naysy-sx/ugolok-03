{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Уголок",
  "version": "1.0.0",
  "identifier": "tech.ugolok.app",
  "build": {
    "frontendDist": "dist-tauri",
    "beforeBuildCommand": "npm --prefix ../.. run build:tauri",
    "beforeDevCommand": "npm --prefix ../.. run build:tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Уголок",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self' data: blob:",
        "media-src": "'self' blob: data:",
        "img-src": "'self' blob: data: https:",
        "connect-src": "'self' wss: https:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    }
  }
}
