# Caddy — реверс-прокси relay (WSS) + Blossom (HTTPS) на порту 443
# (Этап 63, И2). Автоматический HTTPS через Let's Encrypt требует, чтобы
# {$RELAY_DOMAIN}/{$BLOSSOM_DOMAIN} реально указывали (A/AAAA-запись) на
# этот VPS — self-hoster без домена может временно указать IP-адрес,
# Caddy тогда либо не выдаст сертификат (Let's Encrypt не работает по IP),
# либо нужен `tls internal` (самоподписанный, тот же принцип, что агент,
# И1) — ВЫБОР режима ("есть домен" / "только IP") — явно НЕ решён здесь,
# оставлен как переменная окружения USE_INTERNAL_TLS, читаемая ниже, но
# сам механизм подстановки — задача bootstrap-скрипта (И4), не Caddyfile.
#
# TURN/TURNS (coturn) НЕ проксируется здесь — это не HTTP-протокол, Caddy
# в базовой поставке не умеет SNI-passthrough для него (нужен плагин
# caddy-l4 или отдельный nginx stream {} — сознательно отложено, см.
# CONTRACTS.md "Этап 63, И2", "явно НЕ в скоупе"). coturn слушает СВОИ
# порты (3478/5349) напрямую, не через Caddy.

{$RELAY_DOMAIN} {
	reverse_proxy relay:7777
}

{$BLOSSOM_DOMAIN} {
	request_body {
		max_size 512MB
	}
	@blob {
		method GET HEAD
		path_regexp blobhash ^/([0-9a-f]{2})([0-9a-f]{62})$
	}
	handle @blob {
		@have file {
			root /blossom-data
			try_files /blobs/{re.blobhash.1}/{re.blobhash.1}{re.blobhash.2}
		}
		handle @have {
			rewrite * /blobs/{re.blobhash.1}/{re.blobhash.1}{re.blobhash.2}
			root * /blossom-data
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		handle {
			reverse_proxy blossom:8000 {
				flush_interval -1
			}
		}
	}
	handle {
		reverse_proxy blossom:8000 {
			flush_interval -1
		}
	}
}
