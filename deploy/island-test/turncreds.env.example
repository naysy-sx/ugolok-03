# Справочно — TURN общий с прод-островом (хостовый coturn, см. комментарий
# в docker-compose.yml этой папки): отдельного turncreds-server для
# test.ugolok.tech НЕТ и не нужен, deploy/caddy/test.caddy проксирует
# /api/turn-credentials на ТОТ ЖЕ 127.0.0.1:8090, что и prod.caddy —
# сервис поднимается один раз из deploy/island/docker-compose.yml.
#
# Этот файл — не для отдельного сервиса здесь, а чтобы не искать секрет
# только в deploy/island/. Реальный turncreds.env (не в git) кладётся
# рядом с прод-компоузом: /opt/ugolok/island/turncreds.env.
TURN_STATIC_AUTH_SECRET=CHANGE_ME
