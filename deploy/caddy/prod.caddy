ugolok.tech, www.ugolok.tech {
	encode gzip
	root * /var/www/ugolok
	file_server
	try_files {path} /index.html
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
	header /service-worker.js Cache-Control "no-cache"
	header /index.html Cache-Control "no-cache"
	header /config.json Cache-Control "no-cache"
}

git.ugolok.tech {
	encode gzip
	reverse_proxy 127.0.0.1:3000 {
		transport http {
			read_timeout 3600s
			write_timeout 3600s
		}
	}
	request_body {
		max_size 512MB
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
}

relay.ugolok.tech {
	# Firefox: WS не живёт на HTTP/3 (Alt-Svc h3) и часто ломается на h2 CONNECT.
	tls {
		alpn http/1.1
	}
	reverse_proxy 127.0.0.1:7777 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
		flush_interval -1
		transport http {
			versions 1.1
			read_timeout 0
			write_timeout 0
		}
	}
	header -Alt-Svc
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}

blossom.ugolok.tech {
	encode gzip
	reverse_proxy 127.0.0.1:8000 {
		flush_interval -1
	}
	request_body {
		max_size 512MB
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
}
