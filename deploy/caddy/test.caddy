test.ugolok.tech {
	encode gzip
	root * /var/www/ugolok-test
	file_server
	try_files {path} /index.html
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
	header /service-worker.js Cache-Control "no-cache"
	header /index.html Cache-Control "no-cache"
	header /config.json Cache-Control "no-cache"
}

relay.test.ugolok.tech {
	tls {
		alpn http/1.1
	}
	reverse_proxy 127.0.0.1:7778 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
		flush_interval -1
		transport http {
			versions 1.1
			read_timeout 0
			write_timeout 0
		}
	}
	header -Alt-Svc
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}

blossom.test.ugolok.tech {
	encode gzip
	reverse_proxy 127.0.0.1:8001 {
		flush_interval -1
	}
	request_body {
		max_size 512MB
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
}
