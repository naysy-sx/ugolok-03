test.ugolok.tech {
	encode gzip
	# Этап 6 (TZ-cicd-hardening) — тот же turncreds-server, что и на проде
	# (общий coturn — см. deploy/island/README.md "Ветки и выкладка", "TURN общий").
	# handle — не порядок в файле, а встроенный порядок директив Caddy; голый
	# try_files ВНЕ handle выполнился бы раньше и переписал путь до того, как
	# этот matcher успел бы сработать. Несколько handle-блоков в одном сервере
	# — единственный способ получить взаимоисключающий порядок "как написано".
	handle /api/turn-credentials {
		reverse_proxy 127.0.0.1:8090
	}
	handle {
		root * /var/www/ugolok-test
		file_server
		try_files {path} /index.html
	}
	header {
		X-Content-Type-Options nosniff
		Strict-Transport-Security "max-age=31536000"
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
	header /service-worker.js Cache-Control "no-cache"
	header /index.html Cache-Control "no-cache"
	header /config.json Cache-Control "no-cache"
	header /api/turn-credentials Cache-Control "no-store"
}

relay.test.ugolok.tech {
	tls {
		alpn http/1.1
	}
	reverse_proxy 127.0.0.1:7778 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
		flush_interval -1
		transport http {
			versions 1.1
			read_timeout 0
			write_timeout 0
		}
	}
	header -Alt-Svc
	header {
		X-Content-Type-Options nosniff
		Strict-Transport-Security "max-age=31536000"
		Referrer-Policy strict-origin-when-cross-origin
	}
}

blossom.test.ugolok.tech {
	# зеркало blossom.ugolok.tech из prod.caddy — держать в синхроне
	# (FILES-FIX-SPEC.md §8.2/8.4, TZ-FIX-FILES-MEDIA-STATIC.md §5.11).
	reverse_proxy 127.0.0.1:8001 {
		flush_interval -1
		transport http {
			read_timeout 3600s
			write_timeout 3600s
		}
	}
	request_body {
		max_size 512MB
	}
	@blob path_regexp ^/[0-9a-f]{64}$
	header @blob Cache-Control "public, max-age=31536000, immutable"
	header {
		X-Content-Type-Options nosniff
		Strict-Transport-Security "max-age=31536000"
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
	log {
		output file /var/log/caddy/blossom-test-access.log
	}
}
