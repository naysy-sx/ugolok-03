diff --git a/internal/httpapi/blob_fs_test.go b/internal/httpapi/blob_fs_test.go
new file mode 100644
index 0000000..eade43a
--- /dev/null
+++ b/internal/httpapi/blob_fs_test.go
@@ -0,0 +1,204 @@
+package httpapi
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+
+	_ "github.com/mattn/go-sqlite3"
+
+	"github.com/sebdeveloper6952/blossom-server/v2/db"
+	"github.com/sebdeveloper6952/blossom-server/v2/internal/pkg/config"
+	"github.com/sebdeveloper6952/blossom-server/v2/internal/pkg/logging"
+	"github.com/sebdeveloper6952/blossom-server/v2/internal/service"
+)
+
+func setupBlobServer(t *testing.T) (*httptest.Server, *config.Config, []byte, string) {
+	t.Helper()
+	dir := t.TempDir()
+	dbPath := filepath.Join(dir, "database.sqlite3")
+	blobsDir := filepath.Join(dir, "blobs")
+	conf := &config.Config{
+		DbPath:             dbPath,
+		BlobsDir:           blobsDir,
+		LogLevel:           "ERROR",
+		CdnUrl:             "http://localhost",
+		MaxUploadSizeBytes: 64 << 20,
+		AllowedMimeTypes:   []string{"*"},
+	}
+	logger, err := logging.NewLog(conf.LogLevel)
+	if err != nil {
+		t.Fatal(err)
+	}
+	database, err := db.NewDB(dbPath, "../../db/migrations")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { database.Close() })
+	queries := db.New(database)
+	svcs := service.New(context.Background(), database, queries, conf, logger)
+	payload := bytes.Repeat([]byte("ugolok-range-fixture-"), 1024*1024) // ~21 MiB
+	sum := sha256.Sum256(payload)
+	hash := hex.EncodeToString(sum[:])
+	_, err = svcs.Blob().Save(context.Background(), "pk", hash, conf.CdnUrl+"/"+hash, int64(len(payload)), "application/octet-stream", payload, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	engine := SetupRoutes(svcs, conf.CdnUrl, "admin", logger)
+	srv := httptest.NewServer(engine)
+	t.Cleanup(srv.Close)
+	return srv, conf, payload, hash
+}
+
+func TestGetRangeDoesNotRequireFullBodyInSQL(t *testing.T) {
+	srv, conf, payload, hash := setupBlobServer(t)
+
+	req, err := http.NewRequest(http.MethodGet, srv.URL+"/"+hash, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	req.Header.Set("Range", "bytes=0-65535")
+	res, err := http.DefaultClient.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer res.Body.Close()
+	if res.StatusCode != http.StatusPartialContent {
+		t.Fatalf("status %d", res.StatusCode)
+	}
+	if res.Header.Get("Accept-Ranges") != "bytes" {
+		t.Fatalf("Accept-Ranges=%q", res.Header.Get("Accept-Ranges"))
+	}
+	body, err := io.ReadAll(res.Body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(body) != 65536 {
+		t.Fatalf("got %d bytes", len(body))
+	}
+	if !bytes.Equal(body, payload[:65536]) {
+		t.Fatal("range bytes mismatch")
+	}
+	if res.Header.Get("Content-Length") != "65536" {
+		t.Fatalf("Content-Length=%q", res.Header.Get("Content-Length"))
+	}
+
+	onDisk, err := os.ReadFile(service.BlobFilePath(conf.BlobsDir, hash))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(onDisk) != len(payload) {
+		t.Fatalf("disk size %d want %d", len(onDisk), len(payload))
+	}
+}
+
+func TestHeadBlobHasLengthNoBody(t *testing.T) {
+	srv, _, payload, hash := setupBlobServer(t)
+	res, err := http.Head(srv.URL + "/" + hash)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer res.Body.Close()
+	if res.StatusCode != http.StatusOK {
+		t.Fatalf("status %d", res.StatusCode)
+	}
+	if res.Header.Get("Accept-Ranges") != "bytes" {
+		t.Fatalf("Accept-Ranges=%q", res.Header.Get("Accept-Ranges"))
+	}
+	if res.ContentLength != int64(len(payload)) {
+		t.Fatalf("Content-Length %d want %d", res.ContentLength, len(payload))
+	}
+	rest, _ := io.ReadAll(res.Body)
+	if len(rest) != 0 {
+		t.Fatalf("HEAD body %d bytes", len(rest))
+	}
+}
+
+func TestOrphanMetaIs404(t *testing.T) {
+	srv, conf, _, hash := setupBlobServer(t)
+	if err := os.Remove(service.BlobFilePath(conf.BlobsDir, hash)); err != nil {
+		t.Fatal(err)
+	}
+	// empty the sqlite blob column so dual-read cannot recover
+	database, err := db.NewDB(conf.DbPath, "../../db/migrations")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer database.Close()
+	if _, err := database.Exec(`UPDATE blobs SET blob = x'' WHERE hash = ?`, hash); err != nil {
+		t.Fatal(err)
+	}
+	res, err := http.Get(srv.URL + "/" + hash)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer res.Body.Close()
+	if res.StatusCode != http.StatusNotFound {
+		t.Fatalf("status %d want 404", res.StatusCode)
+	}
+}
+
+func TestDualReadWritesFile(t *testing.T) {
+	dir := t.TempDir()
+	dbPath := filepath.Join(dir, "database.sqlite3")
+	blobsDir := filepath.Join(dir, "blobs")
+	conf := &config.Config{
+		DbPath:             dbPath,
+		BlobsDir:           blobsDir,
+		LogLevel:           "ERROR",
+		CdnUrl:             "http://localhost",
+		MaxUploadSizeBytes: 64 << 20,
+		AllowedMimeTypes:   []string{"*"},
+	}
+	logger, err := logging.NewLog(conf.LogLevel)
+	if err != nil {
+		t.Fatal(err)
+	}
+	database, err := db.NewDB(dbPath, "../../db/migrations")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer database.Close()
+	payload := []byte("legacy-sqlite-blob-bytes")
+	sum := sha256.Sum256(payload)
+	hash := hex.EncodeToString(sum[:])
+	_, err = database.Exec(
+		`INSERT INTO blobs(pubkey, hash, type, size, blob, created) VALUES (?,?,?,?,?,?)`,
+		"pk", hash, "text/plain", int64(len(payload)), payload, int64(1),
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	queries := db.New(database)
+	svcs := service.New(context.Background(), database, queries, conf, logger)
+	engine := SetupRoutes(svcs, conf.CdnUrl, "admin", logger)
+	srv := httptest.NewServer(engine)
+	defer srv.Close()
+
+	res, err := http.Get(srv.URL + "/" + hash)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer res.Body.Close()
+	if res.StatusCode != http.StatusOK {
+		t.Fatalf("status %d", res.StatusCode)
+	}
+	got, _ := io.ReadAll(res.Body)
+	if !bytes.Equal(got, payload) {
+		t.Fatalf("body mismatch")
+	}
+	onDisk, err := os.ReadFile(service.BlobFilePath(blobsDir, hash))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(onDisk, payload) {
+		t.Fatal("dual-read did not persist file")
+	}
+}
