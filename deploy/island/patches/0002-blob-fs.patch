+
+type MigrateBlobsResult struct {
+	Total     int
+	Migrated  int
+	Skipped   int
+	Failed    int
+	Bytes     int64
+	OrphanSQL int
+}
+
+func MigrateBlobsToFS(ctx context.Context, queries *db.Queries, blobsDir string, log *zap.Logger) (MigrateBlobsResult, error) {
+	var out MigrateBlobsResult
+	rows, err := queries.ListBlobHashes(ctx)
+	if err != nil {
+		return out, err
+	}
+	out.Total = len(rows)
+	svc := &blobService{queries: queries, blobsDir: blobsDir, log: log}
+	if err := os.MkdirAll(blobsDir, 0o755); err != nil {
+		return out, err
+	}
+	if err := os.MkdirAll(joinTmp(blobsDir), 0o755); err != nil {
+		return out, err
+	}
+
+	for _, row := range rows {
+		path := BlobFilePath(blobsDir, row.Hash)
+		if st, err := os.Stat(path); err == nil && st.Size() == row.Size {
+			out.Skipped++
+			continue
+		}
+		legacy, err := queries.GetBlobBytesFromHash(ctx, row.Hash)
+		if err != nil || len(legacy) == 0 {
+			out.OrphanSQL++
+			out.Failed++
+			if log != nil {
+				log.Warn("migrate: no sqlite blob for hash", zap.String("hash", row.Hash))
+			}
+			continue
+		}
+		sum := sha256.Sum256(legacy)
+		got := hex.EncodeToString(sum[:])
+		if got != row.Hash {
+			out.Failed++
+			if log != nil {
+				log.Error("migrate: sha256 mismatch", zap.String("hash", row.Hash), zap.String("got", got))
+			}
+			continue
+		}
+		if err := svc.writeFileAtomic(row.Hash, legacy); err != nil {
+			out.Failed++
+			if log != nil {
+				log.Error("migrate: write file", zap.String("hash", row.Hash), zap.Error(err))
+			}
+			continue
+		}
+		out.Migrated++
+		out.Bytes += int64(len(legacy))
+	}
+	return out, nil
+}
+
+func DropBlobColumn(ctx context.Context, database *sql.DB) error {
+	if _, err := database.ExecContext(ctx, `ALTER TABLE blobs DROP COLUMN blob`); err != nil {
+		return fmt.Errorf("drop blob column: %w", err)
+	}
+	if _, err := database.ExecContext(ctx, `VACUUM`); err != nil {
+		return fmt.Errorf("vacuum: %w", err)
+	}
+	return nil
+}
+
+func joinTmp(blobsDir string) string {
+	return blobsDir + "/.tmp"
+}
