diff --git a/cmd/migrate-blobs/main.go b/cmd/migrate-blobs/main.go
new file mode 100644
index 0000000..9c63750
--- /dev/null
+++ b/cmd/migrate-blobs/main.go
@@ -0,0 +1,62 @@
+package main
+
+import (
+	"context"
+	"flag"
+	"fmt"
+	"log"
+	"os"
+
+	_ "github.com/mattn/go-sqlite3"
+
+	"github.com/sebdeveloper6952/blossom-server/v2/db"
+	"github.com/sebdeveloper6952/blossom-server/v2/internal/pkg/config"
+	"github.com/sebdeveloper6952/blossom-server/v2/internal/pkg/logging"
+	"github.com/sebdeveloper6952/blossom-server/v2/internal/service"
+)
+
+func main() {
+	configPath := flag.String("config", "config.yml", "path to blossom config.yml")
+	dropColumn := flag.Bool("drop-blob-column", false, "after a successful full migrate, DROP COLUMN blob + VACUUM")
+	flag.Parse()
+
+	conf, err := config.NewConfig(*configPath)
+	if err != nil {
+		log.Fatalf("config: %v", err)
+	}
+	logger, err := logging.NewLog(conf.LogLevel)
+	if err != nil {
+		log.Fatalf("log: %v", err)
+	}
+
+	database, err := db.NewDB(conf.DbPath, "db/migrations")
+	if err != nil {
+		logger.Fatal(err.Error())
+	}
+	defer database.Close()
+	queries := db.New(database)
+	blobsDir := conf.ResolveBlobsDir()
+
+	ctx := context.Background()
+	result, err := service.MigrateBlobsToFS(ctx, queries, blobsDir, logger)
+	if err != nil {
+		logger.Fatal(err.Error())
+	}
+	fmt.Printf("blobs_dir=%s total=%d migrated=%d skipped=%d failed=%d orphan_sql=%d bytes=%d\n",
+		blobsDir, result.Total, result.Migrated, result.Skipped, result.Failed, result.OrphanSQL, result.Bytes)
+
+	if *dropColumn {
+		if result.Failed > 0 || result.OrphanSQL > 0 {
+			fmt.Fprintln(os.Stderr, "refusing --drop-blob-column: migrate had failures/orphans")
+			os.Exit(1)
+		}
+		if err := service.DropBlobColumn(ctx, database); err != nil {
+			logger.Fatal(err.Error())
+		}
+		fmt.Println("dropped blobs.blob + VACUUM")
+	}
+
+	if result.Failed > 0 {
+		os.Exit(1)
+	}
+}
