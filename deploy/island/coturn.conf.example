# prod coturn for ugolok.tech — host network, small UDP range.
# Скопировать в coturn.conf и подставить пароль. chmod 644:
# образ coturn/coturn запускается не от root, иначе -c молча падает в no-auth
# и default 49152-65535 (UFW режет, Chromium: "TURN appears to be broken").
listening-ip=130.17.31.118
relay-ip=130.17.31.118
external-ip=130.17.31.118
listening-port=3478
min-port=49160
max-port=49200
fingerprint
use-auth-secret
static-auth-secret=CHANGE_ME
realm=ugolok.tech
no-cli
no-tls
no-dtls
no-tlsv1
no-tlsv1_1
no-multicast-peers
no-loopback-peers
# TURN — это релей: любой держатель кредов (креды публичные — раздаёт
# turncreds-server без проверки личности, этап 6) может попросить coturn
# соединить его с чем угодно внутренним. no-loopback-peers покрывает не все
# формы адреса (например IPv4-mapped ::ffff:127.0.0.1) — явные диапазоны
# закрывают дыру целиком: облачная metadata (169.254.0.0/16), приватные сети,
# сам loopback и собственный публичный IP этой машины (чтобы релей не мог
# развернуть трафик обратно на другой локальный сервис, слушающий 0.0.0.0).
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=130.17.31.118
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
# Стартовые значения — подобрать по факту использования (docs/environments.md).
# TZ-recovery-policy.md §8 — 10 оказалось мало на практике: 10-LIVE-INCIDENT-
# 2026-09-07.md §5 — один шторм ICE-рестартов (старый код пересоздавал
# RTCPeerConnection БЕЗ явного pc.close() перед этим, TURN-аллокации предыдущих
# попыток висели до серверного таймаута) исчерпал квоту одного пользователя
# за секунды. Явный pc.close() перед пересозданием это устранил (media-
# controller.js, doIceRestart), но 40 — разумный запас на тот же счёт с другой
# стороны: room-звонок на 5 человек — до 4 одновременных граней (mesh), на
# каждой грани при затяжном сбое может идти собственный цикл рестартов
# параллельно (не пересекающиеся TURN-аллокации, каждая грань — отдельный
# RTCPeerConnection) — 4 грани × ~10 (старый предел) с запасом на пересечение
# фаз пересоздания.
total-quota=100
user-quota=40
max-bps=1000000
verbose
log-file=stdout
simple-log

# TZ-recovery-policy.md §8 — TURNS (TLS) на 443, задел, НЕ исправление
# инцидента 2026-09-07 (тот сбой был общим отказом сети, не блокировкой UDP
# конкретно — turns:443 его бы не предотвратил). Единственный путь для сетей,
# которые режут именно UDP/нестандартные TCP-порты целиком, оставляя только
# 443 (гостиничный/корпоративный Wi-Fi, некоторые мобильные операторы) —
# TURN поверх TLS на порту, который эти сети не трогают.
#
# НЕ включено по умолчанию ниже (закомментировано) — раскомментировать
# и заполнить требует ручной работы, которая не входит в это ТЗ:
#   1. Порт 443 на этом хосте уже занят Caddy (deploy/island/Caddyfile,
#      HTTPS для ugolok.tech/test.ugolok.tech) — coturn слушает host-network
#      (docker-compose.yml), просто добавить tls-listening-port=443 здесь
#      столкнётся портами с Caddy. Нужен TCP-демультиплексор ПЕРЕД обоими
#      (например Caddy layer4 app или nginx stream {} с ssl_preread по SNI/
#      ALPN), которого сейчас нет — coturn.conf сам по себе эту часть не решает.
#   2. cert-file/pkey-file — реальный сертификат (Caddy сам управляет своим
#      Let's Encrypt в собственном volume, coturn под user nobody:nogroup
#      нужен отдельный читаемый экземпляр/копия, обновляемая при ротации).
# До решения обоих пунктов раскомментирование ниже даст turnserver, который
# либо не стартует (порт занят), либо стартует и ничего не обслуживает.
#tls-listening-port=443
#cert-file=/etc/coturn/fullchain.pem
#pkey-file=/etc/coturn/privkey.pem
