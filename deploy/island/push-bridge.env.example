# Скопировать в push-bridge.env, подставить секреты. push-bridge.env — в
# .gitignore, не в git (тот же принцип, что turncreds.env).
#
# PUSH_INTERNAL_TOKEN — общий секрет между этим сервисом и плагином strfry
# (server/strfry/whitelist-plugin.mjs, читает его как PUSH_BRIDGE_INTERNAL_TOKEN
# в environment СЕРВИСА relay в docker-compose.yml). Сгенерировать:
#   openssl rand -hex 32
PUSH_INTERNAL_TOKEN=CHANGE_ME_64_HEX_CHARS

# Токен публикации в ntfy — создаётся ПОСЛЕ первого запуска ntfy (см. README.md
# этой папки, раздел ntfy): `docker compose exec ntfy ntfy token add push-bridge`.
PUSH_NTFY_TOKEN=CHANGE_ME

# Внутренний адрес контейнера ntfy в сети docker-compose (имя сервиса — DNS
# внутри compose-сети, порт 80 — см. ntfy.yml listen-http).
PUSH_NTFY_BASE_URL=http://ntfy:80

# Внешний URL, с которым клиент сверяет тег "u" при NIP-98 (должен совпадать
# байт-в-байт с тем, что реально запрашивает клиент). relay.ugolok.tech, не
# ugolok.tech/api/... — push живёт на том же поддомене, что сам relay (П1.1
# «тот же домен, что relay»), см. handle /push/register в deploy/caddy/
# {test,prod}.caddy — путь НЕ стрипается, мост сам слушает ровно "/push/register".
PUSH_REGISTER_URL=https://relay.ugolok.tech/push/register

# Внешний префикс для поля "endpoint" в ответе регистрации — то, что клиент
# подставит в URL подписки ntfy. handle_path /push/* в Caddy СТРИПАЕТ префикс
# перед проксированием в ntfy (тот же Caddy-файл) — снаружи topic виден как
# .../push/<topic>, а сам ntfy получает путь без "/push".
PUSH_PUBLIC_TOPIC_PREFIX=https://relay.ugolok.tech/push

# Необязательно, значения по умолчанию — как ниже:
# PUSH_DB_PATH=/app/data/push.db
# PUSH_HOURLY_CAP=60
# PUSH_LISTEN=0.0.0.0:8091 — НЕ 127.0.0.1 (тот же нюанс, что у turncreds.env.example:
# внутри контейнера это его собственный loopback, недостижимый через проброс
# портов Docker; изоляция на localhost ХОСТА уже даёт docker-compose.yml).
