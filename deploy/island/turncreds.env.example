# Скопировать в turncreds.env, подставить секрет. Тот же секрет — в
# coturn.conf's static-auth-secret (см. README.md "Секрет TURN").
TURN_STATIC_AUTH_SECRET=CHANGE_ME
# Необязательно, значения по умолчанию — как ниже:
# TURN_CREDENTIALS_TTL_SECONDS=3600
# TURN_URIS=turn:ugolok.tech:3478?transport=udp,turn:ugolok.tech:3478?transport=tcp
# TURN_CORS_ORIGINS=https://ugolok.tech,https://test.ugolok.tech
# TURN_CREDS_LISTEN=0.0.0.0:8090 — НЕ 127.0.0.1 (внутри контейнера это его
# собственный loopback, недостижимый через проброс портов Docker; изоляция
# на localhost ХОСТА уже даёт docker-compose.yml "127.0.0.1:8090:8090")
