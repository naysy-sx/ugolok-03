# Скопировать в push-bridge-plugin.env (тот же принцип, что turncreds.env) —
# ДАЖЕ ЕСЛИ push пока не настроен: docker-compose.yml ссылается на этот файл
# в env_file сервиса relay, файл должен физически существовать (пустой —
# нормально, тогда push-forward.mjs просто ничего не пересылает, ИП6).
#
# PUSH_BRIDGE_INTERNAL_TOKEN должен побайтово совпадать с PUSH_INTERNAL_TOKEN
# в push-bridge.env (см. push-bridge.env.example) — общий секрет между
# плагином strfry и push-bridge-server, как TURN_STATIC_AUTH_SECRET между
# coturn.conf и turncreds.env.
PUSH_BRIDGE_INTERNAL_URL=http://push-bridge-server:8091/internal/event
PUSH_BRIDGE_INTERNAL_TOKEN=
